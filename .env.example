# =============================================================================
# pulsechain-mcp v1.0.0 — environment template
# Copy to .env and adjust. Never commit secrets (especially AGENT_WALLET_MASTER_KEY).
# Invalid values fail startup with a clear CONFIG_ERROR on stderr.
#
# Product default: agent wallets ON (master key required).
# Research-only: set AGENT_WALLET_ENABLED=false and leave MASTER_KEY empty.
#
# RPC health: MCP tool get_rpc_health (passive by default; probe=true optional).
# Multi-RPC default order (when unset): g4mm4 → official → publicnode → PulseChainStats.
# One MCP process → one unique AGENT_WALLET_DIR (locks are process-local only).
#
# Cursor / Grok Build / Claude Desktop: use examples/*.json|toml (stdio).
# Do NOT set HTTP_TRANSPORT_PORT for those hosts. See examples/README.md.
# =============================================================================

# -----------------------------------------------------------------------------
# PulseChain multi-RPC (ordered failover: first URL has highest priority)
# -----------------------------------------------------------------------------
# Prefer an ordered list. Failover tries the next URL on timeout, connection
# errors, HTTP 429/5xx, or transport failure.
#
# Recommended priority: local → LAN → g4mm4 → official → publicnode → PulseChainStats
#
# Examples:
#   Local only:
#     PULSECHAIN_RPC_URLS=http://127.0.0.1:8545
#
#   Local + LAN + public:
PULSECHAIN_RPC_URLS=http://127.0.0.1:8545,http://192.168.1.50:8545,https://rpc-pulsechain.g4mm4.io,https://rpc.pulsechain.com,https://pulsechain.publicnode.com,https://rpc.pulsechainstats.com
#
#   Public only:
#     PULSECHAIN_RPC_URLS=https://rpc-pulsechain.g4mm4.io,https://rpc.pulsechain.com,https://pulsechain.publicnode.com,https://rpc.pulsechainstats.com
#
# Legacy single URL (still supported). If both are set, PULSECHAIN_RPC_URL is
# prepended unless it is already first in the list.
# PULSECHAIN_RPC_URL=https://rpc.pulsechain.com
#
# Network: mainnet (chain 369, default) or testnet (chain 943)
# PULSECHAIN_NETWORK=mainnet
# PULSECHAIN_TESTNET_RPC_URLS=https://rpc-testnet-pulsechain.g4mm4.io

# BlockScout-compatible REST API
PULSECHAIN_EXPLORER_API=https://api.scan.pulsechain.com/api

# PulseX subgraph endpoints (public The Graph on PulseChain)
PULSEX_SUBGRAPH_V1=https://graph.pulsechain.com/subgraphs/name/pulsechain/pulsex
PULSEX_SUBGRAPH_V2=https://graph.pulsechain.com/subgraphs/name/pulsechain/pulsexv2

# HTTP client timeout for explorer / subgraph / per-RPC request (milliseconds)
HTTP_TIMEOUT_MS=30000

# -----------------------------------------------------------------------------
# Agent wallet (encrypted keys; on by default — operator-trust when funded)
# -----------------------------------------------------------------------------
# Product default is ON when AGENT_WALLET_ENABLED is unset. Startup requires
# AGENT_WALLET_MASTER_KEY when enabled.
# Agent first-install: follow docs/BOOTSTRAP.md — research-only
# (AGENT_WALLET_ENABLED=false, no master key) unless the user asked to sign.
#
# Operator-trust: funding the agent is authorization.
# Private keys are NEVER returned in tool responses, logs, resources, or audit.
AGENT_WALLET_ENABLED=true

# Required when wallets are enabled (product default):
#   - 64-char hex (32-byte) AES key, optional 0x prefix  → kdf: raw-hex (preferred)
#   - OR strong passphrase (≥16 characters)             → kdf: scrypt
# Lose this key → encrypted wallets are UNRECOVERABLE. Never commit it.
#
# Preferred (write-only — never prints the key; never paste into chat/host config):
#   node scripts/generate-wallet-env.mjs
#   # or: node scripts/install-for-host.mjs --host <grok|cursor|claude|codex> --mode wallets
# Host entry: scripts/start-wallet-mcp.mjs + gitignored .env.wallet (do NOT embed
# AGENT_WALLET_MASTER_KEY in host MCP config). Research-only needs no master key.
# Discouraged: console.log / print-then-paste key generation with agents.
AGENT_WALLET_MASTER_KEY=

# Encrypted wallet JSON, proposals/, append-only audit.jsonl
# Paths under data/wallets/ are gitignored
# One MCP process → one unique AGENT_WALLET_DIR.
AGENT_WALLET_DIR=./data/wallets

# When wallets are enabled, unset/empty defaults to true (refuse writes on live foreign owner).
# Explicit false or 0 is warn-only opt-out. Research-only unset stays false.
# Still NOT a distributed lock — unique dirs are the fix.
# AGENT_WALLET_MULTIPROC_STRICT=false

# HMAC secret (≥32 bytes UTF-8) for MRTR confirm requestState.
# Required when wallets are on AND HTTP_TRANSPORT_PORT is set (fail closed at startup).
# Stdio wallets-on may omit it (process-local secret; cannot resume across restarts/instances).
# Do NOT reuse AGENT_WALLET_MASTER_KEY.
# AGENT_WALLET_MRTR_SECRET=

# Do NOT set MAX_PLS_PER_TX / MAX_PLS_DAILY as product "safety" knobs.
# Operator-trust: funding the agent is authorization; small balances + kill_switch
# are the real controls. Optional legacy env parse remains for compatibility only
# and is intentionally omitted from templates (not hard gates).

# -----------------------------------------------------------------------------
# Switch.win aggregator (optional — switch_quote / switch_prepare_swap)
# -----------------------------------------------------------------------------
# Operator-gated: request a key at https://docs.switch.win/aggregator/request-api-key
# Place as SWITCH_API_KEY only in local env. Prefer piteas_quote without a key.
# SWITCH_API_KEY=

# -----------------------------------------------------------------------------
# Optional Streamable HTTP transport (local testing only)
# -----------------------------------------------------------------------------
# Leave empty for stdio (Claude Desktop / Cursor / Grok).
# If set, binds 127.0.0.1 only. Not for public exposure.
HTTP_TRANSPORT_PORT=

# -----------------------------------------------------------------------------
# Logging (stderr only — never stdout; stdout is MCP JSON-RPC)
# -----------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
