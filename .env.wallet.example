# Operator-trust: funding the agent is authorization; MAX_PLS_* are not hard gates.
# =============================================================================
# pulsechain-mcp — dedicated wallet process template (v1.0.2+)
# =============================================================================
# Write-only ceremony (RECOMMENDED — never prints the key):
#   node scripts/generate-wallet-env.mjs
#   # or: node scripts/install-for-host.mjs --host <grok|cursor|claude|codex> --mode wallets
#
# That creates LOCAL .env.wallet (gitignored) from this example, fills the key,
# refuses if .env.wallet already exists, sets mode 600 where supported.
#
# NEVER:
#   - console.log / print the master key
#   - paste the key into chat or host config
#   - read_file / cat .env.wallet to "verify" (existence check + agent_wallet_status only)
#   - commit a filled .env.wallet
#
# Preferred host entry (no MASTER_KEY in host config):
#   scripts/start-wallet-mcp.mjs
#
# Research-only hosts: AGENT_WALLET_ENABLED=false, no this file (see examples/*).
#
# PulseChain gas reality (operator / agent):
#   EIP-1559 is active; gas is priced in BEATS (1 PLS = 1e18 BEATS).
#   Fees in PLS terms are often large even when USD cost is small:
#     - simple PLS transfers: tens of PLS gas
#     - approvals / token transfers: tens to low hundreds of PLS
#     - swaps: often ~250+ PLS gas
#   Do NOT treat PulseChain like low-gwei Ethereum.
#
# Operator-trust: funding the agent is authorization. Real controls are small
# balances, unique wallet dir, master key custody, and kill_switch — not
# MAX_PLS_* env "caps" (those are not product spend-cap safety; omit them).
#
# Operator steps (AFTER bootstrap smoke; never fund during install):
#   1. create_agent_wallet (confirm=true)
#   2. verify address via agent_wallet_status / list_agent_wallets
#   3. fund with enough PLS for gas + intended value (see docs/SECURITY.md)
#   4. inspect_tx_intent → propose_agent_tx → reviewSummary → execute_agent_tx
#
# See docs/BOOTSTRAP.md, docs/SECURITY.md.
# =============================================================================

AGENT_WALLET_ENABLED=true

# Strong master key — filled only by generate-wallet-env / install-for-host (write-only).
# Preferred: 64-char hex (raw AES). Alternate: passphrase ≥16 chars (scrypt).
# Discouraged: node -e "console.log(...)" into chat or host env.
AGENT_WALLET_MASTER_KEY=

# UNIQUE directory for this wallet-enabled process only.
AGENT_WALLET_DIR=./data/wallets

# Refuse writes if another live process owns the dir.
AGENT_WALLET_MULTIPROC_STRICT=true

# Optional multi-RPC
# PULSECHAIN_RPC_URLS=http://127.0.0.1:8545,https://rpc-pulsechain.g4mm4.io,https://rpc.pulsechain.com,https://pulsechain.publicnode.com,https://rpc.pulsechainstats.com

# Leave unset for stdio hosts (Cursor / Grok / Claude).
# HTTP_TRANSPORT_PORT=

LOG_LEVEL=info
