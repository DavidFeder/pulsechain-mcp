# =============================================================================
# pulsechain-mcp — Docker env template (v1.0.0)
# Copy to .env.docker (gitignored). Never commit secrets.
#
# Image/compose smoke defaults to research-only (no secrets in the image).
# Product code default is wallets-on when AGENT_WALLET_ENABLED is unset — so
# containers set AGENT_WALLET_ENABLED=false unless you add a master key.
#
#   cp .env.docker.example .env.docker
#   # edit this file — compose env_file loads it into the container
#   docker compose up --build
#
# Cursor / Grok / Claude should use host Node stdio (examples/*), not this file.
# =============================================================================

# Multi-RPC (ordered: first = highest priority)
# Co-located Go-Pulse on the same machine (Docker Desktop / Compose):
#   host.docker.internal → host loopback services (e.g. JSON-RPC :8545)
#
# Linux host-network alternative:
#   PULSECHAIN_RPC_URLS=http://127.0.0.1:8545,https://rpc-pulsechain.g4mm4.io,...
#
# Public-only:
#   PULSECHAIN_RPC_URLS=https://rpc-pulsechain.g4mm4.io,https://rpc.pulsechain.com,https://pulsechain.publicnode.com,https://rpc.pulsechainstats.com

PULSECHAIN_RPC_URLS=http://host.docker.internal:8545,https://rpc-pulsechain.g4mm4.io,https://rpc.pulsechain.com,https://pulsechain.publicnode.com,https://rpc.pulsechainstats.com

# -----------------------------------------------------------------------------
# Agent wallet — Docker smoke defaults to research-only (no baked secrets)
# -----------------------------------------------------------------------------
# Product default elsewhere is wallets-on. Containers must opt in with a key.
# One container → one unique wallet directory/volume. Never share volumes.
AGENT_WALLET_ENABLED=false

# Required only when AGENT_WALLET_ENABLED=true (64-char hex preferred). Never bake into image.
# AGENT_WALLET_MASTER_KEY=
# AGENT_WALLET_DIR=/app/data/wallets
# AGENT_WALLET_MULTIPROC_STRICT=true
# Funding authorizes spend. No spend-cap env knobs.

# -----------------------------------------------------------------------------
# Transport
# -----------------------------------------------------------------------------
# Leave empty for stdio. Set only for local HTTP smoke (binds 127.0.0.1).
# Do NOT set this for Cursor/Grok/Claude host configs.
# HTTP_TRANSPORT_PORT=
# AGENT_WALLET_MRTR_SECRET is unused for wallet writes; HTTP does not require it.

LOG_LEVEL=info
