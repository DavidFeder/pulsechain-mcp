# =============================================================================
# Compatibility template (filename kept for local operator continuity)
# =============================================================================
# Prefer the product template: copy `.env.wallet.example` → local `.env.wallet`.
# This file matches older local env filenames so existing operator copies still
# have a documented shape. Local filled copies remain gitignored.
# The wallet launcher still accepts this filename as a fallback after `.env.wallet`.
#
# Operator-trust: funding the agent is authorization; no product spend-cap knobs.
# =============================================================================
# pulsechain-mcp — dedicated wallet process template (v1.0.0+)
# =============================================================================
# Copy to a LOCAL file only (recommended name: .env.wallet — gitignored).
# NEVER commit the real master key or a filled wallet env.
#
# Purpose: enable agent wallets on a dedicated MCP process with a unique
# AGENT_WALLET_DIR and multiproc strict. Research-only hosts set
# AGENT_WALLET_ENABLED=false (see .env.example and examples/*).
#
# PulseChain gas reality (operator / agent):
#   EIP-1559 is active; gas is priced in BEATS (1 PLS = 1e18 BEATS).
#   Base fees are often hundreds of thousands of BEATS, so fees in PLS terms
#   are commonly large even when USD cost is small:
#     - simple PLS transfers: tens of PLS gas
#     - approvals / token transfers: tens to low hundreds of PLS
#     - swaps: often ~250+ PLS gas
#   Do NOT treat PulseChain like low-gwei Ethereum.
#
# Operator-trust: fund wallet = value + gas headroom. Real controls are small
# balances, unique dir, master key, and kill_switch — not MAX_PLS_* env vars
# (omit them; they are not hard send gates and are not product defaults).
# Recommended order once funded: native transfer first → approve/token → swap-class.
#
# Operator steps (no broadcast required until you fund for gas+value):
#   1. create_agent_wallet (confirm=true)
#   2. verify address via agent_wallet_status / list_agent_wallets / get_agent_wallet_info
#   3. fund later with enough PLS for gas + intended value (see docs/SECURITY.md)
#   4. then inspect_tx_intent → propose_agent_tx → reviewSummary → execute_agent_tx
#
# See docs/SECURITY.md (essentials) and docs/SECURITY_DEEP.md (residual).
# Preferred host entry: scripts/start-wallet-mcp.mjs
# =============================================================================

AGENT_WALLET_ENABLED=true

# Strong master key — never commit; never paste into chat or host config.
# Preferred write-only (never prints the key):
#   node scripts/generate-wallet-env.mjs
#   # or: node scripts/install-for-host.mjs --host <host> --mode wallets
# Prefer local name .env.wallet + scripts/start-wallet-mcp.mjs.
# Preferred key shape: 64-char hex (raw AES). Alternate: passphrase ≥16 (scrypt).
# Discouraged: console.log / print-then-paste with agents.
AGENT_WALLET_MASTER_KEY=

# UNIQUE directory for this wallet-enabled process only.
# One MCP process → one unique AGENT_WALLET_DIR. Locks are process-local only.
AGENT_WALLET_DIR=./data/wallets

# Refuse writes if another live process owns the dir.
# Still NOT a distributed lock — unique dirs remain the real multi-instance fix.
AGENT_WALLET_MULTIPROC_STRICT=true

# Optional: multi-RPC (same as RO; create/verify does not require funds)
# PULSECHAIN_RPC_URLS=http://127.0.0.1:8545,https://rpc-pulsechain.g4mm4.io,https://rpc.pulsechain.com,https://pulsechain.publicnode.com,https://rpc.pulsechainstats.com

# Leave unset for stdio hosts (Cursor / Grok / Claude).
# HTTP_TRANSPORT_PORT=

LOG_LEVEL=info
